# Single source of truth for pinned versions.
# Policy (D9/anti-hallucination): image tags + tool versions are RESOLVED by the
# first successful provision, then FROZEN here to exact digests. Values marked
# RESOLVE are intentionally loose until doctor records the real version.
BOX_HOST=52.23.218.124
BOX_USER=ubuntu
BOX_DIR=/home/ubuntu/seclab-web3
SCRATCH=/opt/dlami/nvme/seclab          # big/ephemeral: models, fork cache, images

OLLAMA_IMAGE=ollama/ollama:latest        # RESOLVE->freeze digest
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:latest   # RESOLVE->freeze digest
MODEL_REF=qwen2.5-coder:14b              # Qwen2.5-Coder-14B-Instruct, Q4 (D11)

# analysis image build pins (RESOLVE->freeze after first green build)
